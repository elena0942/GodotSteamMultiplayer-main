[gd_scene format=3 uid="uid://bgiqftg43tv13"]

[sub_resource type="GDScript" id="GDScript_oqqnt"]
script/source = "extends Control

@onready var hotbar_container = $hotbar_hboxcontainer

func _ready():
	Global.inventory_updated.connect(_update_hotbar)
	_update_hotbar()

func _update_hotbar():
	clear_hotbar_container()
	for i in range(Global.hotbar_size):
		var item = Global.hotbar_inventory[i]
		var slot = Global.inventory_slot_scene.instantiate()
		slot.set_slot_index(i)
		hotbar_container.add_child(slot)
		if item != null:
			slot.set_item(item)
		else:
			slot.set_empty()
		slot.update_assignment_status()

func clear_hotbar_container():
	while hotbar_container.get_child_count() > 0:
		var child = hotbar_container.get_child(0)
		hotbar_container.remove_child(child)
		child.queue_free()

##TEST

